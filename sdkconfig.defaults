# ESP32-S3 / BLE central baseline
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y

CONFIG_BLE_CONN_MGR_ROLE_CENTRAL=y
CONFIG_BLE_MIDI_PROFILE=y

# BLE-MIDI commonly uses encrypted/bonded links.
# Just Works + bonding + LE Secure Connections, no display/passkey UI.
CONFIG_BLE_CONN_MGR_SM=y
CONFIG_BLE_CONN_MGR_SM_IO_CAP_NO_IO=y
CONFIG_BLE_CONN_MGR_SM_CAP=10
CONFIG_BLE_CONN_MGR_SM_KEY_DIST=3

CONFIG_LOG_DEFAULT_LEVEL_INFO=y


# Hardware V2 - ESP32-S3 N16R8
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB Octal PSRAM used by the 480x320 UI framebuffer.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Larger NVS for controller presets/scenes.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Stage 08B.1: stack headroom for BLE system events and manual diagnostics.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
